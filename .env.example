# Production values must be supplied by Bank IT and must not be committed.
APP_ENV=production
APP_VERSION=1.0.0
BASE_PERIOD=1404-04

# Target production data source
DATA_SOURCE_TYPE=sqlserver
DATA_SOURCE_CONNECTION_STRING=

# Target production scenario persistence
SCENARIO_DB_TYPE=sqlserver
SCENARIO_DB_CONNECTION_STRING=

# Target enterprise authentication / identity integration
AUTH_MODE=enterprise
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
