# Production values must be supplied by Bank IT and must not be committed.
APP_ENV=production
APP_VERSION=1.0.0
BASE_PERIOD=1404-04

# Branch grading baseline data source
# Supported handover values: excel | sqlserver
DATA_SOURCE_TYPE=sqlserver
DATA_FILE_PATH=Data.xlsx
DATA_SOURCE_CONNECTION_STRING=
DATA_SOURCE_TABLE_OR_VIEW=vw_BranchGradingInput

# Scenario persistence
# Supported handover values: sqlite | sqlserver
SCENARIO_DB_TYPE=sqlserver
SCENARIO_DB_PATH=storage/scenarios.db
SCENARIO_DB_CONNECTION_STRING=

# Identity
# Supported handover values: local | enterprise
AUTH_MODE=enterprise
LOCAL_USER_CONFIG_PATH=config/local_user.json
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
